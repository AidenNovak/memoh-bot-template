{
  "schema_version": 1,
  "id": "debate-salon",
  "name": "三椅茶会 · 观点圆桌",
  "category": "original",
  "icon": "🪑",
  "description": "用户带来一个决策问题，三把椅子轮流陈述并接受追问。",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "sources": [
    {
      "title": "SillyTavern：Character Design",
