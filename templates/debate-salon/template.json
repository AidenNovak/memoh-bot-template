    },
    "skills": [],
    "apps": [],
    "connectors": [],
    "agents": [],
    "hooks": {
      "binding": "inherit"
    },
    "sampling": {
      "temperature": "模型/Provider能力决定；当前Bot Settings无该字段",
      "top_p": "模型/Provider能力决定",
      "max_tokens": "模型配置决定"
    }
  }
}
