    },
    "chat_runtime": {
      "binding": "inherit"
    },
    "command_ui_language": "auto",
    "compaction_enabled": true,
    "compaction_model_id": {
      "binding": "inherit"
    },
    "compaction_target_percent": 50,
    "compaction_threshold": 48000,
    "default_bot_agent_id": {
      "binding": "inherit"
    },
    "discuss_probe_model_id": {
      "binding": "inherit"
    },
    "display_enabled": {
      "binding": "inherit"
    },
    "fetch_provider_id": {
      "binding": "inherit"
